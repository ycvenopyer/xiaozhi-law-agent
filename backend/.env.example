# 本地服务。EdgeOne 环境变量由项目设置提供。
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=*
LOG_LEVEL=info

# CloudBase PG 和认证。与前端指向同一环境并使用同一个 Publishable Key。
CLOUDBASE_ENV_ID=xiaozhi-law-agent-d3d75m0c534925
CLOUDBASE_PUBLISHABLE_KEY=
# 仅后端。运行 002_login_names.sql 后从私有 login_config 表获取。
XIAOZHI_LOGIN_LOOKUP_KEY=
# 长 Key 可用 CLOUDBASE_PUBLISHABLE_KEY_PART_1、PART_2 等连续分段。
# 仅填写完整值或分段二者之一。使用 scripts/split-cloudbase-key.ps1 生成。

# 按需启用智谱内置模型，将 Key 保存在后端环境。
ZHIPU_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
