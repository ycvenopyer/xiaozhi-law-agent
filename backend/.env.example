# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ============================================
# LLM (OpenAI-compatible) Configuration
# Any provider that exposes an OpenAI-compatible /chat/completions endpoint works.
# Examples:
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   通义千问  : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   混元      : LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_MODEL=hunyuan-turbo
# ============================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# CloudBase PG: same Publishable Key as the frontend, NOT service_role.
CLOUDBASE_ENV_ID=xiaozhi-law-agent-d3d75m0c534925
CLOUDBASE_PUBLISHABLE_KEY=
# EdgeOne long keys: omit the unsplit variable; use CLOUDBASE_PUBLISHABLE_KEY_PART_1,
# CLOUDBASE_PUBLISHABLE_KEY_PART_2, ... generated by scripts/split-cloudbase-key.ps1.
# Existing models become selectable when their platform API key is configured.
# Each account must still explicitly enable third-party model processing.
