# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ============================================
# LLM (OpenAI-compatible) Configuration
# Any provider that exposes an OpenAI-compatible /chat/completions endpoint works.
# Examples:
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#   通义千问  : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   混元      : LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_MODEL=hunyuan-turbo
# ============================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ============================================
# Web Search (optional) — enables live legal/case retrieval
# Without this, the assistant answers from its own knowledge and flags
# statutes/cases for the lawyer to verify.
#   Tavily (recommended, free tier): WEB_SEARCH_PROVIDER=tavily  WEB_SEARCH_API_KEY=xxx
#   SerpAPI                    : WEB_SEARCH_PROVIDER=serpapi WEB_SEARCH_API_KEY=xxx
# ============================================
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
